# Secrets — .env.example is committed, .env is never
.env
.env.*
!.env.example

# Build output
/bin/
/dist/
*.exe
*.exe~

# Test artifacts
*.out
coverage.*
/tmp/

# Frontend (Stage 3+)
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
/web/test-results/
/web/playwright-report/
/web/blob-report/
/web/playwright/.cache/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# Claude Code — personal permission allowlist, not shared project config
.claude/settings.local.json

# AI-tooling-specific files kept locally, not published — untracked rather than deleted, so
# they stay exactly as they are on disk for local use.
/CLAUDE.md
/docs/stage2-sync-design.md

# Scratch / local output
/output/

# Design-review screenshots are normally regenerated on demand. The images below are
# referenced in the README and landing pages, so they must be versioned.
/web/shots/*
