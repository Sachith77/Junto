# Copy to .env for local development:  cp .env.example .env
#
# Every value here is a development default. Secrets have NO defaults in code — the process
# refuses to start without them, so a misconfigured deploy fails loudly at boot instead of
# silently running with a well-known key.

JUNTO_ENV=development

# --- Logging ---
LOG_LEVEL=debug
LOG_FORMAT=text

# --- HTTP ---
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# How long to keep serving AFTER readiness starts failing and BEFORE the listener closes.
# Zero locally — there is no load balancer to notify and nobody wants Ctrl+C to pause.
#
# Production defaults to 8s when this variable is UNSET, because skipping the drain is how a
# rolling deploy 502s: server.Shutdown stops accepting instantly, but the load balancer only
# finds out at its next probe. Two constraints if you change it (see docs/deploy.md):
#   HTTP_DRAIN_DELAY > readiness probe interval x failures needed
#   the platform's kill timeout > HTTP_DRAIN_DELAY + HTTP_SHUTDOWN_TIMEOUT
HTTP_DRAIN_DELAY=0

# Bounds ALL health probes collectively, not each one. Short on purpose: a probe slower than
# the orchestrator's own timeout is indistinguishable from a dead instance.
HTTP_PROBE_TIMEOUT=2s

# --- Database ---
# Matches docker-compose.yml. sslmode=disable is rejected by config validation in production.
DATABASE_URL=postgres://junto:junto_dev_password@localhost:5433/junto?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# --- Redis (optional) ---
# Absent means SINGLE INSTANCE: operation fan-out and WebSocket handshake tickets are held in
# process memory. That is a legitimate way to run this app and is what Compose gives you.
#
# Set it to run more than one instance. Without it, a ticket minted on one instance cannot be
# redeemed on another (handshakes fail at random behind a load balancer without sticky
# sessions) and neither instance's subscribers see the other's writes.
# Host port 6380, matching docker-compose.yml.
REDIS_URL=redis://localhost:6380/0

# --- Auth ---
# Development value only. Generate a real one with:  openssl rand -base64 48
# Must be at least 32 bytes: HS256 uses a 256-bit HMAC key, and a shorter secret makes the
# signature weaker than the algorithm it is feeding.
JWT_SECRET=dev-only-insecure-secret-replace-me-in-every-real-environment

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_TTL=2160h
EMAIL_VERIFY_TTL=24h
PASSWORD_RESET_TTL=1h
WS_TICKET_TTL=30s
# --- Local convenience: skip email verification (DEVELOPMENT ONLY) ---
#
# Marks new accounts verified at signup, so signup -> log in works without opening
# Mailpit. Config validation REFUSES this in production: D29 requires a verified
# email precisely so an address that was never proven cannot leave an account
# unrecoverable by password reset. Set it to false to exercise the real flow.
AUTH_AUTO_VERIFY_EMAIL=true


# Argon2id. OWASP's second recommended profile. Raising these later is safe: each hash
# encodes the parameters it was made with, so old passwords keep verifying and are
# transparently upgraded on next login.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# --- Email (Mailpit in docker-compose; UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Junto <no-reply@junto.local>
SMTP_USE_TLS=false

# --- URLs used to build verification and invitation links ---
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000

# --- Object storage (attachments) ---
#
# Optional, exactly like REDIS_URL: with no endpoint the attachment routes are not mounted and
# the rest of the API is unaffected. Host:port with NO scheme — use STORAGE_USE_SSL for https.
# Matches the MinIO service in docker-compose.yml; the same values work unchanged against real
# S3 or Cloudflare R2, which is the point of presigning through minio-go.
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=junto
STORAGE_SECRET_KEY=junto_dev_password
STORAGE_BUCKET=junto-attachments
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
